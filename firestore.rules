rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // NOTE: Avoid get() inside rules when possible — expensive and can cause
    // permission errors during auth bootstrap. Role-based access for write
    // operations is enforced at the application layer (AuthContext + RoleRoute).

    // ── docentes collection ──────────────────────────────────
    // Any authenticated user can read (needed during login to load their own profile)
    // Write: owner can update their own doc (lastLogin, fcmToken, etc.)
    match /docentes/{userId} {
      allow read: if isSignedIn();
      // create: any signed-in user can create (admins create docs for new teachers/families
      // whose UID differs from their own — role enforcement is done in the app layer)
      allow create: if isSignedIn();
      allow update: if isSignedIn(); // role enforcement done in app layer
      allow delete: if false;        // never delete via client
    }

    // ── config (app settings) ───────────────────────────────
    // AuthContext reads /config/appSettings on every login — must be readable
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // only via Firebase Console / admin SDK
    }

    // ── estudiantes collection ──────────────────────────────
    match /estudiantes/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── cursos collection ────────────────────────────────────
    match /cursos/{cursoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();

      match /calificaciones/{calId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── mensajes (broadcasts) ────────────────────────────────
    match /mensajes/{msgId} {
      allow read: if isSignedIn();
      // Anyone can create (role check done in App layer — SENDER_ROLES guard)
      allow create: if isSignedIn();
      // Full update for sender; partial update (leido only) for others
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // ── chats (direct messages) ──────────────────────────────
    match /chats/{chatId} {
      // Only participants can access
      allow read, update: if isSignedIn() &&
        request.auth.uid in resource.data.participantes;

      // Creator must include themselves as participant
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participantes;

      // Messages subcollection — inherits parent participant check via app layer
      match /mensajes/{mensajeId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── audit / logs ─────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read, write: if isSignedIn();
    }

    // ── configuracion (per-user settings) ────────────────────
    match /configuracion/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // ── organizacion institucional ────────────────────────────
    match /organizacion/{docId} {
      allow read, write: if isSignedIn();
    }
  }
}